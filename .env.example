# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ML PLATFORM — Environment Variable Reference                          ║
# ║                                                                        ║
# ║  SETUP INSTRUCTIONS:                                                   ║
# ║    1. Copy this file:  cp .env.example .env                           ║
# ║    2. Replace every CHANGE_ME with a generated secret (see below)     ║
# ║    3. NEVER commit .env — it is already in .gitignore                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Inside Docker use host 'db'. For local uvicorn use 'localhost'.
# Generate a strong password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/mlplatform

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# CRITICAL — rotating this invalidates ALL active user sessions.
# Generate:  python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 64 hex characters (256-bit entropy).
SECRET_KEY=CHANGE_ME_generate_with_secrets.token_hex_64

# Token lifetimes (no secrets — safe to adjust)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object Storage (MinIO locally / S3-compatible in prod) ───────────────────
# Inside Docker use host 'minio'. For local uvicorn use 'localhost:9000'.
S3_ENDPOINT_URL=http://minio:9000

# Generate access key (20–24 alphanumeric chars):
#   python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(24)))"
S3_ACCESS_KEY=CHANGE_ME

# Generate secret key (40 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
S3_SECRET_KEY=CHANGE_ME

S3_BUCKET_NAME=ml-datasets

# Storage backend: "local" (filesystem uploads/) | "minio" (MinIO/S3)
STORAGE_BACKEND=local

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Inside Docker use host 'redis'. For local uvicorn use 'localhost:6379'.
# Add password in production: redis://:REDIS_PASSWORD@redis:6379/0
REDIS_URL=redis://redis:6379/0

# ── Portfolio Certificate Signing ─────────────────────────────────────────────
# HMAC key used to sign cryptographic portfolio certificates (QR verification).
# Generate:  python -c "import secrets; print(secrets.token_hex(48))"
# NOT setting this in production means certificates can be forged — set it.
MLPLAYGROUND_CERT_SECRET=CHANGE_ME_generate_with_secrets.token_hex_48
