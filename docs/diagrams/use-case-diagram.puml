@startuml
title ML Playground — Use Case Diagram
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F5FB
  BorderColor #4B3B7C
  ArrowColor #4B3B7C
}
skinparam rectangle {
  BorderColor #4B3B7C
  BackgroundColor #FFFFFF
}
skinparam actor {
  BorderColor #3F315F
  FontColor #211A34
}

actor "Platform User" as User
actor "Classroom Instructor" as Instructor
actor "Classroom Student" as Student
actor "External Prediction Client" as Client

rectangle "ML Playground" {
  (Register Account) as UC_Register
  (Sign In / Sign Out) as UC_Auth
  (Manage Datasets) as UC_Dataset
  (Upload CSV Dataset) as UC_Upload
  (View Dataset Profile and Quality) as UC_Profile
  (Get Algorithm Recommendations) as UC_Recommend
  (Configure and Launch Training) as UC_Train
  (Monitor / Cancel Training Job) as UC_Job
  (View Training Results and Compare Experiments) as UC_Results
  (Edit Pipeline / Python Experiment Code) as UC_Code
  (Manage Model Deployments) as UC_Deploy
  (Manage Model Registry and Versions) as UC_Registry
  (Run Model Predictions) as UC_Predict
  (Read User Guide) as UC_Guide
  (Use AI Copilot) as UC_Copilot

  (Create Classroom and Assignments) as UC_CreateClass
  (Manage Classroom Roster) as UC_Roster
  (Review Submissions and Grades) as UC_Grade
  (Join Classroom) as UC_Join
  (Complete Lab Assignment / Exam) as UC_Exam
  (Submit Lab Work) as UC_Submit

  UC_Dataset ..> UC_Upload : <<include>>
  UC_Dataset ..> UC_Profile : <<include>>
  UC_Train ..> UC_Recommend : <<extend>>
  UC_Results ..> UC_Job : <<include>>
  UC_Deploy ..> UC_Registry : <<extend>>
  UC_Exam ..> UC_Submit : <<include>>
}

User --> UC_Register
User --> UC_Auth
User --> UC_Dataset
User --> UC_Recommend
User --> UC_Train
User --> UC_Job
User --> UC_Results
User --> UC_Code
User --> UC_Deploy
User --> UC_Registry
User --> UC_Predict
User --> UC_Guide
User --> UC_Copilot

Instructor --> UC_CreateClass
Instructor --> UC_Roster
Instructor --> UC_Grade
Instructor --> UC_Join
Student --> UC_Join
Student --> UC_Exam
Student --> UC_Submit

Client --> UC_Predict

note bottom of UC_Predict
  Covers the API prediction endpoints
  and deployment-specific prediction route.
end note

@enduml