# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Docker local overrides (may contain secrets or personal paths)
docker-compose.override.yml
docker-compose.local.yml

# Uploads and temporary test artifacts
services/api/uploads/
uploads/

# MinIO local data (contains actual stored object bytes)
services/minio/data/

# Private key files — never commit
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.crt

# Terraform — may contain cloud credentials
*.tfvars
!*.tfvars.example
terraform.tfstate
terraform.tfstate.*
.terraform/

# Secret scanners
.secrets.baseline
